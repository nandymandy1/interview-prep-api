NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=interview_prep.sid
LOG_LEVEL=debug
# Optional backend-only key for public interview discussion research (Brave
# Search API). When absent, discussion research degrades to a structured
# unavailable result; boot and company-site research are unaffected.
BRAVE_SEARCH_API_KEY=
# Required for kit generation (single Gemini provider, backend only). The API
# boots without them, but generation jobs fail with a clear error.
GEMINI_API_KEY=
GEMINI_MODEL=
# LLM selection: openai|gemini. Omit only when exactly one provider's
# key+model pair above/below is configured (auto-detect); both pairs without
# LLM_PROVIDER is a configuration error. No runtime fallback between providers.
LLM_PROVIDER=
# OpenAI provider (backend only). Used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
