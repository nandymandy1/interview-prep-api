NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=interview_prep.sid
LOG_LEVEL=debug
# Optional backend-only key for public interview discussion research (Brave
# Search API). When absent, discussion research degrades to a structured
# unavailable result; boot and company-site research are unaffected.
BRAVE_SEARCH_API_KEY=

# Required for kit generation: exactly one LLM provider, backend only. The API
# boots without them, but generation jobs fail with a clear error.
# LLM selection: openai|gemini. Omit LLM_PROVIDER only when exactly one
# provider's key+model pair is configured (auto-detect); both pairs without
# LLM_PROVIDER is a configuration error. No runtime fallback between providers.
# Transient 429/5xx/network failures retry with bounded exponential backoff +
# jitter (max 3 attempts); 401/403 normalize to LLM_AUTH_INVALID, never retried.
LLM_PROVIDER=openai

OPENAI_API_KEY=
# Submitted production model (verified against the live provider).
OPENAI_MODEL=gpt-5.6-terra

GEMINI_API_KEY=
GEMINI_MODEL=

# Exact-input generation reuse (pristine material only, never user edits).
# Suggested: 7 days.
GENERATION_CACHE_TTL_DAYS=7
# Company research reuse (canonical URL + version + mode). Suggested: 24h.
RESEARCH_CACHE_TTL_HOURS=24
